# Config generated by Ghostty Config
font-size = 11
font-family = MesloLGS NF
# 入っていない環境では読み飛ばされ、システムのフォントにフォールバックする
font-family = Osaka

window-padding-x = 8
window-padding-y = 8
window-padding-balance = true

theme = Kanagawa Wave
bold-is-bright = true
background-opacity = 0.9
background = #202020

font-feature = -dlig
term = xterm-256color

# OS 専用の設定 (linux/ghostty/config, mac/ghostty/config へのリンク: scripts/link.sh)
config-file = ?os
