#!/bin/sh
# tuigreet の --session-wrapper。選んだセッションの Exec (例: niri --session) を引数に受けて起動する
# (scripts/void.sh が /etc/greetd/ にインストールする)

# systemd が無い環境では PipeWire と gcr-ssh-agent をここ (と zsh) で管理する
# (systemd ではユーザーサービスが起動する)
manage_daemons() {
    [ ! -d /run/systemd/system ]
}

# dbus-run-session から呼び直されたとき: セッションの D-Bus 上で PipeWire を起動してからセッションを実行する
if [ "${1:-}" = "--in-dbus-session" ]; then
    shift
    if manage_daemons; then
        # WirePlumber と pipewire-pulse は PipeWire が起動する (scripts/void.sh)
        pipewire &
    fi
    exec "$@"
fi

# greetd はログインシェルを経由しないので、環境変数はここで設定する
# (XDG_CURRENT_DESKTOP は tuigreet が設定する)
desktop="${XDG_CURRENT_DESKTOP%%:*}"
[ -n "$desktop" ] || desktop="$(basename "$1")"

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_SESSION="$desktop"
export DESKTOP_SESSION="$desktop"
export QT_QPA_PLATFORM="wayland;xcb"
# export GDK_DPI_SCALE=1
# export QT_SCALE_FACTOR=1
export MOZ_ENABLE_WAYLAND=1
export WINIT_UNIX_BACKEND=x11
export XDG_SCREENSHOTS_DIR="$HOME/Pictures/screenshots"
# export QT_IM_MODULE=fcitx
# export GTK_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx
export DefaultIMModule=fcitx
export INPUT_METHOD=fcitx
export XCURSOR_PATH="${XCURSOR_PATH}:$HOME/.icons"

# ログ: ~/.local/state/<desktop>/<desktop>.log
log_dir="$HOME/.local/state/$desktop"
mkdir -p "$log_dir"

# 前のセッションのデーモンは死んだ D-Bus に繋がったまま残り、
# git の SSH 署名の失敗や PipeWire の二重起動を起こすので、セッションの前後で止める
stop_session_daemons() {
    manage_daemons || return 0
    gcr_dir="${XDG_RUNTIME_DIR:-$HOME/.cache}/gcr"
    # gcr-ssh-agent のパスはディストリで異なるので照合に含めない。子の ssh-agent も止める
    pkill -u "$(id -u)" -f "gcr-ssh-agent --base-dir $gcr_dir\$"
    pkill -u "$(id -u)" -f "ssh-agent -D -a $gcr_dir/\.ssh\$"
    rm -f "$gcr_dir/ssh" "$gcr_dir/.ssh"
    pkill -u "$(id -u)" -x "pipewire|pipewire-pulse|wireplumber"
}

stop_session_daemons
dbus-run-session "$0" --in-dbus-session "$@" >"$log_dir/$desktop.log" 2>&1
status=$?
stop_session_daemons
exit "$status"
