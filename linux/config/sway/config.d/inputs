# set xkeyboard layout
# キーボード設定

input type:keyboard {
    xkb_layout jp
    xkb_model pc106
    xkb_options "grp:win_space_toggle" 
}

input type:pointer {
    accel_profile flat
    pointer_accel 0.1
}

input type:touchpad {
    natural_scroll enabled  # ナチュラルスクロール
    dwt enabled              # タイピング中は無効化
}
