// 使い方: zellij --layout dev
//
// +-----------------+---------+
// | nvim            | claude  |
// |                 |         |
// +-----------------+         |
// | shell / server  |         |
// +-----------------+---------+
//
// shell と server はスタックで、Alt j / Alt k でフォーカスした方が展開される。
// claude も Alt c で同じようにスタックへ追加できる。
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }
    tab focus=true {
        pane split_direction="vertical" {
            pane size="70%" {
                // タブ名を起動ディレクトリ名にしてから nvim を起動する
                pane size="75%" name="nvim" command="sh" focus=true {
                    args "-c" "zellij action rename-tab \"$(basename \"$PWD\")\"; exec nvim"
                }
                pane size="25%" stacked=true {
                    pane name="shell" expanded=true
                    pane name="server"
                }
            }
            pane size="30%" command="claude" {
                args "--ide"
            }
        }
    }
}
